# Copy to .env and adjust. All values below are safe local-development examples.

# PostgreSQL (docker compose exposes it on 127.0.0.1:55480)
DATABASE_URL="postgresql://gpuswapper:gpuswapper_dev_only@127.0.0.1:55480/gpuswapper?schema=public"
# Used by `npm test` (a separate database is created by docker/init-test-db.sql)
TEST_DATABASE_URL="postgresql://gpuswapper:gpuswapper_dev_only@127.0.0.1:55480/gpuswapper_test?schema=public"

# Session cookie encryption secret — at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-change-me-dev-only-change-me-0000"

# Public base URL of the app. start.sh rewrites it to http://<public-ip>:3410 on EC2.
# The session cookie is marked Secure only when this starts with https:// (override: COOKIE_SECURE).
APP_URL="http://localhost:3410"

# Demo mode: shows the demo banner and enables demo sign-in hints on the login page.
# Must be "false" in production.
DEMO_MODE="true"

# Password used by `npm run db:seed` for the four fictional demo accounts.
# The seed refuses to run when NODE_ENV=production.
SEED_DEMO_PASSWORD="DemoPass!2026"

# Private file storage (outside /public). "local" is the only adapter implemented;
# the StorageAdapter interface is ready for an S3-compatible private bucket.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage/private"
MAX_UPLOAD_MB="10"

# Email: "console" logs messages to the server console (safe for local dev).
# Set to "smtp" only after implementing/configuring a real provider (not included in the MVP).
EMAIL_DRIVER="console"
EMAIL_FROM="no-reply@example.invalid"
